# Config overlay for the end-to-end streaming test (test_e2e/pytest_webrtc_classic.py).
# Committed on purpose: carries no secrets. Device credentials live in the
# gitignored sdkconfig.creds fragment, generated by test_e2e/conftest.py.

# The test asserts on `DIAG frame_cb: send_v_fps=` from kvs_media.c to confirm the
# device is actually pushing frames, not just holding a connected session.
CONFIG_KVS_WEBRTC_MEDIA_DIAG_LOG=y

# webrtc_classic's own sdkconfig.defaults turns BLE provisioning on, which parks the
# boot waiting for a phone. The test drives Wi-Fi over the `wifi-set` console command
# instead, so provisioning must be off for an unattended run.
CONFIG_APP_NETWORK_PROV_BLE=n

# The log-based oracle needs the Espressif-side ESP_LOGI lines ([KVS Event] ...,
# signaling phase timings, peer state changes) to reach the console.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The receive-path player is dead weight for this test -- it only asserts
# device -> viewer streaming. On p4_eye it also fails to init (bsp_display_new:
# SPI init failed) while still allocating the tinyh264 decoder.
# CONFIG_MEDIA_STREAM_ENABLE_VIDEO_PLAYER is not set

# Hardware AES is deliberately left ENABLED here. It used to be disabled because
# esp-aes could not allocate its DMA descriptor array, which broke the TLS write
# carrying the SDP answer. That turned out to be a consequence of the video player
# above, not of AES: with the player on, a board whose display init fails still pays
# for the tinyh264 decoder, and internal RAM fell to ~20 KB free with only ~13 KB
# contiguous -- too fragmented for a contiguous MALLOC_CAP_DMA|MALLOC_CAP_INTERNAL
# block. With the player off the floor is ~66 KB free / ~31 KB contiguous and
# hardware AES runs clean. Measured, not assumed; see test_e2e/README.md.
