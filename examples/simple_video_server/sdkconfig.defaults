CONFIG_SPIRAM=y

CONFIG_CAMERA_SC2336=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_SPIRAM_SPEED_200M=y

CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=16

# Since we use esp_video, which needs latest I2C driver
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

#
# mbedTLS features the KVS SDK needs. ESP-IDF v5.x defaulted both to y; v6
# (mbedTLS 4) defaults them to n, which breaks the DTLS-SRTP negotiation and the
# self-signed DTLS certificate the SDK generates.
#
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
# Needed for the DTLS-SRTP fingerprint check; ESP-IDF v6 no longer defaults it on.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
CONFIG_MBEDTLS_X509_CREATE_C=y
