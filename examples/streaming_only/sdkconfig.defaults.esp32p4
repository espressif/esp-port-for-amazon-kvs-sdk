
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

#
# ESP System Settings
#
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

#
# ESP NETIF Adapter
#
CONFIG_ESP_NETIF_IP_LOST_TIMER_INTERVAL=120
CONFIG_ESP_NETIF_TCPIP_LWIP=y
# CONFIG_ESP_NETIF_LOOPBACK is not set
CONFIG_ESP_NETIF_USES_TCPIP_WITH_BSD_API=y

#
# ESP PSRAM
#
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200

#
# PSRAM offload — required across all ESP32-P4 board variants for this
# streaming workload. Without these, kvs_webrtc / webrtc_bridge / cert
# buffers fill internal SRAM and FreeRTOS fails to allocate the main
# task stack at boot (assert at app_startup.c:86). Move BSS/noinit +
# general malloc to SPIRAM; keep DMA/small allocs internal.
#
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# CONFIG_SPIRAM_USE_CAPS_ALLOC is not set

#
# esp_hosted SDIO transport buffers in SPIRAM. Without this the internal
# DMA pool is too small under streaming-grade RAM use. Gated by the
# downstream patch in components/esp_hosted.
#
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y

#
# Cache config
#
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_SIZE=0x20000
CONFIG_CACHE_L2_CACHE_LINE_64B=y
CONFIG_CACHE_L2_CACHE_LINE_SIZE=64
CONFIG_CACHE_L1_CACHE_LINE_SIZE=64

### sdkconfig for ESP32-P4 + C2 as co-processor
# Wi-Fi Performance
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_IRAM_OPT=n
CONFIG_WIFI_RMT_RX_IRAM_OPT=n
CONFIG_WIFI_RMT_EXTRA_IRAM_OPT=n
CONFIG_WIFI_RMT_SLP_IRAM_OPT=n

# TCP/IP Performance

CONFIG_LWIP_TCP_SACK_OUT=y

#
# SDIO
#
# 2.x set CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_MAX_SIZE here, a name with no
# 3.x counterpart that never applied - so the host silently used esp_hosted's
# default, streaming mode, which is what pairs with the co-processor's SW_AGGR
# default. Translating it to the live symbol selected packet mode instead and
# the pair aborts at bring-up:
#   SDIO mode mismatch: slave is in streaming mode, but host is in packet mode
# Left unset: esp_hosted's default is correct for this pair.
#CONFIG_ESP_SDIO_CHECKSUM=y
# 2.x CONFIG_ESP_HOSTED_PKT_STATS had a host and a co-processor side. 3.x keeps
# packet stats on the co-processor only (CONFIG_ESP_PKT_STATS, CP scope), so the
# host has nothing to set here.

# hosted_recovery watches the co-processor heartbeat; 3.x makes it opt-in.
CONFIG_ESP_HOSTED_HOST_FEAT_HEARTBEAT=y

# webrtc_bridge carries signaling and commands over hosted peer data.
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y

# CONFIG_SLAVE_LWIP_ENABLED had no 3.x counterpart: under network
# split the co-processor always runs its own lwIP.
CONFIG_ESP_HOSTED_HOST_FEAT_NW_SPLIT=y
CONFIG_HOST_USES_STATIC_NETIF=n
#CONFIG_LWIP_TCP_LOCAL_PORT_RANGE_START=49152
#CONFIG_LWIP_TCP_LOCAL_PORT_RANGE_END=61439
#CONFIG_LWIP_UDP_LOCAL_PORT_RANGE_START=49152
#CONFIG_LWIP_UDP_LOCAL_PORT_RANGE_END=61439

#
# Use Hosted lib
#
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_HOST_TO_ESP_WIFI_DATA_THROTTLE=n
CONFIG_ESP_HOSTED_SLAVE_RESET_ONLY_IF_NECESSARY=n

# For V1.0B board
# CONFIG_BSP_BOARD_TYPE_SAMPLE_V10B=y
# CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=49
# CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=50

# For V1.2 Board
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
#CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
#CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
#CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

#
# Default Supported Camera Sensors
#
CONFIG_CAMERA_OV2710=y
CONFIG_CAMERA_OV2710_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV2710_MIPI_RAW10_1920X1080_25FPS=y

CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1920x1080_30FPS=y

CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920x1080_30FPS=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y


#CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
#CONFIG_ESP_HOSTED_P4_C5_CORE_BOARD=y

# Hosted - Host Power Save Config
CONFIG_ESP_HOSTED_HOST_FEAT_POWER_SAVE=y
CONFIG_ESP_HOSTED_HOST_FEAT_POWER_SAVE_DEEP_SLEEP_ALLOWED=y
CONFIG_ESP_HOSTED_HOST_FEAT_POWER_SAVE_WAKEUP_GPIO=6

# hosted_recovery handles transport failures (re-establish, not blind host restart)
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# Make BSP errors non-fatal — by default bsp_display_indev_init() ESP_ERROR_CHECKs
# on bsp_touch_new() failure, which aborts the whole app when the GT911 touch
# controller is not wired (some EV Function Board SKUs ship display without
# touch). With this disabled, the BSP returns the error code; our
# video_render_display.c already handles a NULL return from
# bsp_display_start_with_config gracefully.
CONFIG_BSP_ERROR_CHECK=n

#
# ECDSA hardware not supported on chip revisions < v3.0
# Use software ECDSA instead to avoid DTLS handshake failures
#
CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN=n
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n

# ─── Aligned with esp_hosted's power-save reference ────────────────────────────
# examples/power_save/host+cp/network_split__host_deep_sleep_cp_light_sleep/esp_host.
# Keep these equal to the example. Settings the example makes that are specific
# to it are deliberately not copied: it disables the interrupt and task
# watchdogs, uses a single large partition, and pulls in iperf and the
# wifi-cmd component.

# Network split: the host netif takes its address from the co-processor's
# DhcpDnsStatus event rather than running DHCP itself.
CONFIG_ESP_HOSTED_HOST_FEAT_NW_SPLIT_NETIF_INTERNAL_STATIC=y

# The application owns association; hosted must not connect or reconnect.
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_STA_AUTO_CONNECT_ON_START=n
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_STA_AUTO_RECONNECT_ON_DISCONNECT=n

# Remote Wi-Fi buffering and BA windows for split throughput.

# lwIP. The old CONFIG_TCP_* names below were 2.x-era and never applied, so the
# stack had been running on IDF defaults.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=51200
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_IP_REASS_MAX_PBUFS=15
CONFIG_LWIP_TCP_SACK_OUT=y
# The example also sets CONFIG_LWIP_IRAM_OPTIMIZATION and
# CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION. They do not fit here: this application
# links WebRTC, mbedTLS, libsrtp and the H.264 encoder, and moving lwIP into
# IRAM on top of that overflows internal RAM at link time
# ("--enable-non-contiguous-regions discards section").
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
