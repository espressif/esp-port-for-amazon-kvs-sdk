
# esp_hosted defaults its co-processor choice to ESP32, which is BLE 4.2 only, and
# errors out if BLE 5 is on. The s3 has native Wi-Fi (no co-processor) and uses
# NimBLE only for provisioning, so the BLE 5 features are not needed here.
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# signaling_only on this target uses the MQTT bridge and the chip has native
# Wi-Fi, so the esp_hosted host has no role here. Leaving it on selects a host
# SDIO transport whose sdkconfig.rename aliases collide with the legacy
# CONFIG_ESP_SDIO_* names the esp_hosted slave Kconfig still declares.
CONFIG_ESP_HOSTED_ENABLED=n
