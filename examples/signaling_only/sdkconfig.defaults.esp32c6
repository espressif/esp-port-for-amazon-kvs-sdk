# perform the size optimized builds for C6 to avoid app size overflow
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# SPI Configuration
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n

# SPI Flash driver
CONFIG_SPI_FLASH_ROM_DRIVER_PATCH=n
CONFIG_SPI_FLASH_ROM_IMPL=y

# Peripheral Control
CONFIG_PERIPH_CTRL_FUNC_IN_IRAM=n

#
# ESP System Settings
#
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=y

# Event Loop Library
CONFIG_ESP_EVENT_POST_FROM_ISR=n

#
# PThreads
#
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8000
CONFIG_PTHREAD_STACK_MIN=4096

CONFIG_MAIN_TASK_STACK_SIZE=6000
CONFIG_IPC_TASK_STACK_SIZE=1024
CONFIG_TIMER_TASK_STACK_SIZE=3584
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y

#
# Wi-Fi
#
# C6 internal-RAM budget: keep WiFi code out of IRAM so internal SRAM
# stays available for runtime allocations (KVS signaling payloads can
# exceed 4 KB, slave_rpc outbuf allocs them out of internal heap).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n

# Same reason — move GDMA and FreeRTOS scheduler code from IRAM to flash.
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=n
CONFIG_FREERTOS_IN_IRAM=n

CONFIG_FREERTOS_HZ=1000

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

#
# ESP-Hosted - Network coprocessor
#
# CONFIG_SLAVE_LWIP_ENABLED=y   # no Kconfig defines this in 2.x or 3.x
CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT=y
CONFIG_EH_TRANSPORT_CP_SDIO_RX_Q_SIZE=10
CONFIG_EH_TRANSPORT_CP_SDIO_TX_Q_SIZE=10

# Disable ESP-Hosted coprocessor app_main (we provide our own)
# CONFIG_ESP_HOSTED_COPROCESSOR_APP_MAIN=n   # no Kconfig defines this in 2.x or 3.x

# Create wifi sta in example, instead of internal slave code base
# CONFIG_ESP_HOSTED_REUSE_WIFI_STA_DEF_NETIF_INSTANCE=y   # no Kconfig defines this in 2.x or 3.x
CONFIG_ESP_HOSTED_CP_FEAT_BT=n

# Hosted - Re-use CLI instance
CONFIG_ESP_HOSTED_CP_CLI_NEW_INSTANCE=n

# Hosted : Host deep sleep & wake up
# CONFIG_ESP_SDIO_STREAMING_MODE=n   # no Kconfig defines this in 2.x or 3.x
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_DEEP_SLEEP=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_UNLOAD_BUS_WHILE_SLEEPING=y
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_HOST_WAKEUP_GPIO=2

# Hosted - Light sleep on Deep sleep
CONFIG_PM_ENABLE=y
# Enable peripheral powerdown for maximum power saving during light sleep
# This requires proper IRAM placement for ISR handlers - matches rmaker_split_camera
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_LE_SLEEP_ENABLE=y
# BLE is used only for provisioning. Running the controller from flash frees
# about 23 KB of internal RAM, which the C6 needs for TLS and media forwarding.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
# ESP_HOSTED_CP_LIGHT_SLEEP_ENABLE is a promptless helper derived from this
# choice; assigning it directly has no effect. POWER_MAX is the mode that
# selects the PM, tickless-idle, bus-unload and peripheral-powerdown options
# already listed below.
CONFIG_ESP_HOSTED_CP_LIGHT_SLEEP_POWER_MAX=y
CONFIG_ESP_HOSTED_CP_LIGHT_SLEEP_MIN_FREQ_MHZ=10
CONFIG_ESP_PHY_MAC_BB_PD=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# ─── Aligned with esp_hosted's power-save reference ────────────────────────────
# examples/power_save/host+cp/network_split__host_deep_sleep_cp_light_sleep/cp.
# Keep these equal to the example; only app-specific settings above differ
# (BLE provisioning stays enabled here, and the partition table is ours).

# host_ps_integration_init() calls eh_cp_feat_host_ps_cp__enable() with the
# four sleep callbacks. Auto-init would bring the feature up first, without
# them, so the example turns it off and lets the application own the order.
CONFIG_ESP_HOSTED_CP_FEAT_HOST_PS_AUTO_INIT=n

# Under network split the host connects on STA_START (it usually starts Wi-Fi
# before this app is up). app_wifi_prov here connects after applying its config
# and reconnects on disconnect. esp_hosted's own connect on STA_START would race
# them.
CONFIG_ESP_HOSTED_CP_FEAT_NW_SPLIT_WIFI_AUTO_CONNECT_ON_STA_START=n

# Wi-Fi init config. The host sends its own on every boot and deep-sleep wake,
# and the co-processor re-initialises Wi-Fi when the two differ. That drops the
# link and the signaling session. These are the values every P4 host that pairs
# with a C6 resolves to. The P4 allocates Wi-Fi and lwIP from PSRAM, so
# esp_wifi_remote gives it static TX buffers only and 16 static RX buffers. The
# streaming_only p4_eye, p4x_eye and p4_function_ev_board_v16 overlays set the
# same RX values. The Wi-Fi IRAM options stay off, as set above.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=16
