menu "Slave Flasher Configuration"

    config SLAVE_FLASHER_ENABLE
        bool "Enable slave flashing via host"
        default n
        help
            Enable the slave flasher component to flash firmware to a slave ESP32
            device via UART. When enabled, the host device can flash bootloader,
            partition table, and application binaries to the slave device.

    choice SLAVE_FLASHER_IMAGE_SOURCE
        prompt "Slave image source"
        default SLAVE_FLASHER_IMAGE_SPIFFS
        depends on SLAVE_FLASHER_ENABLE
        help
            Select where flash_slave() reads bootloader.bin, partition-table.bin
            and app.bin from.

        config SLAVE_FLASHER_IMAGE_SPIFFS
            bool "SPIFFS partition 'slave'"
            help
                The component packs the images into a SPIFFS partition with the
                label 'slave'. An app OTA does not update this partition.

        config SLAVE_FLASHER_IMAGE_EMBEDDED
            bool "Embedded in the app binary"
            help
                Embed the images in the app binary as rodata. Each app OTA
                then brings its own slave image. The 'slave' partition and
                the spiffs component are not necessary.
    endchoice

    config SLAVE_FLASHER_IMAGE_DIR
        string "Directory with the slave images"
        default "target-firmware"
        depends on SLAVE_FLASHER_ENABLE
        help
            Directory that holds bootloader.bin, partition-table.bin and app.bin.
            A relative path starts at the project directory.

    config SLAVE_PARTITION_TABLE_ADDRESS
        hex "Partition Table Address"
        default 0xC000
        depends on SLAVE_FLASHER_ENABLE
        help
            Flash address where the partition table will be written.
            Default is 0xC000 (49152 decimal).

    config SLAVE_APPLICATION_ADDRESS
        hex "Application Address"
        default 0x20000
        depends on SLAVE_FLASHER_ENABLE
        help
            Flash address where the application binary will be written.
            Default is 0x20000 (131072 decimal).

    config SLAVE_UART_RX_PIN
        int "UART RX Pin"
        default 22
        depends on SLAVE_FLASHER_ENABLE || SLAVE_CONSOLE_ENABLE
        help
            GPIO pin number for UART RX.
            Default is 22.

    config SLAVE_UART_TX_PIN
        int "UART TX Pin"
        default 21
        depends on SLAVE_FLASHER_ENABLE || SLAVE_CONSOLE_ENABLE
        help
            GPIO pin number for UART TX.
            Default is 21.

    config SLAVE_GPIO0_TRIGGER_PIN
        int "GPIO0 Trigger Pin"
        default 20
        depends on SLAVE_FLASHER_ENABLE
        help
            GPIO pin number for GPIO0 trigger.
            Default is 20.

    config SLAVE_CONSOLE_ENABLE
        bool "Forward the co-processor console to the host"
        default y if SLAVE_FLASHER_ENABLE
        default n
        help
            Pipe the co-processor's UART output to the host log behind a "[SLAVE]"
            prefix, and register the write_slave command. Independent of
            SLAVE_FLASHER_ENABLE, so a co-processor programmed another way keeps
            its console. TX is driven only while write_slave sends, so a
            co-processor with its own USB-UART bridge on the same lines is safe.

endmenu

