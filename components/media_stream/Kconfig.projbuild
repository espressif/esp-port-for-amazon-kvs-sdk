            endif

            menuconfig MEDIA_STREAM_ENABLE_SPI_CAM_0_SENSOR
                bool "SPI Camera Sensor 0"
                default n if IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S3
                default y
                depends on ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE
                help
                    Serial Peripheral Interface for camera sensors 0.
                    Typically used for lower resolution sensors or special applications.
                    Requires fewer GPIO pins than DVP but has lower bandwidth.
        
            if MEDIA_STREAM_ENABLE_SPI_CAM_0_SENSOR
                choice MEDIA_STREAM_SPI_CAM_0_INTERFACE
                    prompt "Interface Of SPI Camera Sensor 0"
                    default MEDIA_STREAM_SPI_CAM_0_INTERFACE_SPI
                    help
                        Select the interface for SPI camera sensor 0:

                        - SPI: Uses the general SPI Interface to receive picture stream from the camera sensor
                        - Parallel I/O: Use the parallel I/O Interface to simulate the SPI Interface to receive
                                        picture stream from the camera sensor

                    config MEDIA_STREAM_SPI_CAM_0_INTERFACE_SPI
                        bool "SPI"
                        help
                            Uses the general SPI Interface to receive picture stream from the camera sensor.
                    
                    config MEDIA_STREAM_SPI_CAM_0_INTERFACE_PARLIO
                        bool "Parallel I/O"
                        depends on CAM_CTLR_SPI_ENABLE_PARLIO
                        help
                            Use the parallel I/O Interface to simulate the SPI Interface to receive picture
                            stream from the camera sensor. this feature is only available for ESP32-P4, 
                            ESP32-C5 and ESP32-C6 series.
                endchoice

                choice MEDIA_STREAM_SPI_CAM_0_IO_MODE
                    prompt "I/O Mode Of SPI Camera Sensor 0"
                    default MEDIA_STREAM_SPI_CAM_0_IO_MODE_1BIT
                    depends on MEDIA_STREAM_SPI_CAM_0_INTERFACE_PARLIO
                    help
                        Select the I/O mode for SPI camera sensor 0:

                        - 1-bit: the data I/O bus transforms 1-bit data per clock
                        - 2-bit: the data I/O bus transforms 2-bit data per clock, this is faster than 1-bit

                    config MEDIA_STREAM_SPI_CAM_0_IO_MODE_1BIT
                        bool "1-bit"
                        help
                            The data I/O bus transforms 1-bit data per clock.
                    
                    config MEDIA_STREAM_SPI_CAM_0_IO_MODE_2BIT
                        bool "2-bit"
                        help
                            The data I/O bus transforms 2-bit data per clock.
                endchoice

                config MEDIA_STREAM_SPI_CAM_0_SCCB_I2C_PORT
                    int "SCCB(I2C) Port Number"
                    default 0
                    range 0 2 if IDF_TARGET_ESP32P4
                    range 0 1 if IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32C5
                    range 0 0
                    depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                    help
                        I2C port number for camera sensor control communication.

                        SCCB (Serial Camera Control Bus) is an I2C-compatible
                        protocol used for camera sensor configuration.

                config MEDIA_STREAM_SPI_CAM_0_SCCB_I2C_FREQ
                    int "SCCB(I2C) Frequency (100K-400K Hz)"
                    default 100000
                    range 100000 400000
                    help
                        I2C clock frequency for camera sensor communication.

                        Recommended values:
                        - 100000 Hz (100kHz): Standard speed, most compatible
                        - 400000 Hz (400kHz): Fast mode, reduces initialization time

                        Higher frequencies reduce sensor initialization time but may
                        cause issues with some sensors or longer cable connections.

                config MEDIA_STREAM_SPI_CAM_0_SPI_PORT
                    int "SPI Port Number"
                    default 2 if IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S3
                    default 1
                    range 0 2 if IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S3
                    range 0 1
                    help
                        SPI peripheral number for camera data communication.

                choice MEDIA_STREAM_SPI_CAM_0_XCLK_SOURCE
                    prompt "Select XCLK Source"
                    default MEDIA_STREAM_SPI_CAM_0_XCLK_USE_LEDC if CAMERA_XCLK_USE_LEDC
                    default MEDIA_STREAM_SPI_CAM_0_XCLK_USE_CLOCK_ROUTER if CAMERA_XCLK_USE_ESP_CLOCK_ROUTER
                    help
                        Select the clock source for generating camera sensor XCLK.

                        - LEDC Timer: Uses LED Controller timer for clock generation
                        - ESP Clock Router: Uses dedicated clock routing hardware

                    config MEDIA_STREAM_SPI_CAM_0_XCLK_USE_LEDC
                        bool "LEDC Timer"
                        depends on CAMERA_XCLK_USE_LEDC
                        help
                            Use LED Controller timer to generate camera clock.
                            Provides good accuracy and is available on all ESP32 variants.

                    config MEDIA_STREAM_SPI_CAM_0_XCLK_USE_CLOCK_ROUTER
                        bool "ESP Clock Router"
                        depends on CAMERA_XCLK_USE_ESP_CLOCK_ROUTER
                        help
                            Use dedicated clock routing hardware for camera clock.
                            Provides better performance and lower jitter when available.
                endchoice

                config MEDIA_STREAM_SPI_CAM_0_XCLK_FREQ
                    int "XCLK Frequency (Hz)"
                    default 24000000 if IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32C5
                    default 20000000
                    help
                        Master clock frequency for SPI camera sensor.

                if MEDIA_STREAM_SPI_CAM_0_XCLK_USE_LEDC
                    config MEDIA_STREAM_SPI_CAM_0_XCLK_TIMER
                        int "XCLK LEDC Timer Number"
                        default 0
                        range 0 3
                        help
                            LEDC timer number for camera clock generation.

                    config MEDIA_STREAM_SPI_CAM_0_XCLK_TIMER_CHANNEL
                        int "XCLK LEDC Timer Channel"
                        default 0
                        range 0 7 if IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S3
                        range 0 5
                        help
                            LEDC timer channel for camera clock output.
                endif

                if BSP_SELECT_NONE
                    config MEDIA_STREAM_SPI_CAM_0_SCCB_I2C_SCL_PIN
                        int "SCCB(I2C) SCL Pin"
                        default 8 if IDF_TARGET_ESP32P4
                        default 5
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        range 0 21 if IDF_TARGET_ESP32C3
                        range 0 30 if IDF_TARGET_ESP32C6
                        range 0 29 if IDF_TARGET_ESP32C61
                        range 0 28 if IDF_TARGET_ESP32C5
                        depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                        help
                            GPIO pin for I2C clock signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_0_SCCB_I2C_SDA_PIN
                        int "SCCB(I2C) SDA Pin"
                        default 7 if IDF_TARGET_ESP32P4
                        default 4
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        range 0 21 if IDF_TARGET_ESP32C3
                        range 0 30 if IDF_TARGET_ESP32C6
                        range 0 29 if IDF_TARGET_ESP32C61
                        range 0 28 if IDF_TARGET_ESP32C5
                        depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                        help
                            GPIO pin for I2C data signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_0_SENSOR_RESET_PIN
                        int "Reset Pin"
                        default -1
                        range -1 54 if IDF_TARGET_ESP32P4
                        range -1 48 if IDF_TARGET_ESP32S3
                        range -1 21 if IDF_TARGET_ESP32C3
                        range -1 30 if IDF_TARGET_ESP32C6
                        range -1 29 if IDF_TARGET_ESP32C61
                        range -1 28 if IDF_TARGET_ESP32C5
                        help
                            GPIO pin for camera sensor hardware reset.
                            Set to -1 if not connected or not required.

                    config MEDIA_STREAM_SPI_CAM_0_SENSOR_PWDN_PIN
                        int "Power Down Pin"
                        default -1
                        range -1 54 if IDF_TARGET_ESP32P4
                        range -1 48 if IDF_TARGET_ESP32S3
                        range -1 21 if IDF_TARGET_ESP32C3
                        range -1 30 if IDF_TARGET_ESP32C6
                        range -1 29 if IDF_TARGET_ESP32C61
                        range -1 28 if IDF_TARGET_ESP32C5
                        help
                            GPIO pin for camera sensor power-down control.
                            Set to -1 if not connected or not required.

                    config MEDIA_STREAM_SPI_CAM_0_XCLK_PIN
                        int "XCLK Output Pin"
                        default 20 if IDF_TARGET_ESP32P4
                        default 15 if IDF_TARGET_ESP32S3
                        default 8 if IDF_TARGET_ESP32C3
                        default 0 if IDF_TARGET_ESP32C6 || IDF_TARGET_ESP32C61 || IDF_TARGET_ESP32C5
                        range -1 54 if IDF_TARGET_ESP32P4
                        range -1 48 if IDF_TARGET_ESP32S3
                        range -1 21 if IDF_TARGET_ESP32C3
                        range -1 30 if IDF_TARGET_ESP32C6
                        range -1 29 if IDF_TARGET_ESP32C61
                        range -1 28 if IDF_TARGET_ESP32C5
                        help
                            GPIO pin for camera sensor master clock output.
                            Set to -1 if not connected or not required.

                    config MEDIA_STREAM_SPI_CAM_0_CS_PIN
                        int "Chip Select Pin"
                        default 37 if IDF_TARGET_ESP32P4
                        default 6 if IDF_TARGET_ESP32S3
                        default 10 if IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5
                        default 1 if IDF_TARGET_ESP32C6
                        default 8 if IDF_TARGET_ESP32C61
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        range 0 21 if IDF_TARGET_ESP32C3
                        range 0 30 if IDF_TARGET_ESP32C6
                        range 0 29 if IDF_TARGET_ESP32C61
                        range 0 28 if IDF_TARGET_ESP32C5
                        help
                            GPIO pin for SPI chip select signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_0_SCLK_PIN
                        int "Clock Pin"
                        default 4 if IDF_TARGET_ESP32P4
                        default 13 if IDF_TARGET_ESP32S3
                        default 6
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        range 0 21 if IDF_TARGET_ESP32C3
                        range 0 30 if IDF_TARGET_ESP32C6
                        range 0 29 if IDF_TARGET_ESP32C61
                        range 0 28 if IDF_TARGET_ESP32C5
                        help
                            GPIO pin for SPI clock signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_0_DATA0_IO_PIN
                        int "Data0 I/O Pin"
                        default 21 if IDF_TARGET_ESP32P4
                        default 16 if IDF_TARGET_ESP32S3
                        default 7
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        range 0 21 if IDF_TARGET_ESP32C3
                        range 0 30 if IDF_TARGET_ESP32C6
                        range 0 29 if IDF_TARGET_ESP32C61
                        range 0 28 if IDF_TARGET_ESP32C5
                        help
                            GPIO pin for SPI data0 input/output to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_0_DATA1_IO_PIN
                        int "Data1 I/O Pin"
                        default 5 if IDF_TARGET_ESP32P4
                        default 9
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 29 if IDF_TARGET_ESP32C61
                        range 0 28 if IDF_TARGET_ESP32C5
                        depends on MEDIA_STREAM_SPI_CAM_0_IO_MODE_2BIT
                        help
                            GPIO pin for SPI data1 input/output to camera sensor.
                endif
            endif

            menuconfig MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR
                bool "USB-UVC"
                depends on SOC_USB_OTG_SUPPORTED
                select ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE
                help
                    USB Video Class (UVC) interface for standard USB cameras.

                    UVC is a standardized USB protocol that enables plug-and-play
                    connectivity with a wide range of USB camera devices without
                    requiring custom drivers.

                    Features:
                    - Standard USB interface with no custom drivers needed
                    - Support for multiple resolutions and formats
                    - Hot-plug capability for dynamic camera connection/disconnection
                    - Power and data transmission over single USB cable
                    - Compatible with most commercial USB webcams and industrial cameras

                    Ideal for applications requiring external camera connectivity,
                    webcam integration, or when GPIO pins are limited.

                    Also set CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096. A UVC
                    configuration descriptor enumerates every format, frame size and frame
                    interval, so it runs well past the 256-byte default and enumeration
                    fails.

                    Limitations on esp32p4
                    ----------------------
                    This branch builds against uvc components without support for rate control
                    (usb_host_uvc, esp_video), so some things do not work as expected:

                    - No camera-side rate control.
                    - No on-demand key frames.
                    - Cameras that never set the EoF payload flag deliver no frames at all.

                    CONFIG_MEDIA_STREAM_UVC_TARGET_FPS (VIDIOC_S_PARM) and the capture
                    resolution are the only levers left, and with passthrough the camera's
                    fixed bitrate makes resolution a weak one.

            if MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR
                config MEDIA_STREAM_USB_UVC_DEVICES_NUM
                    int "USB UVC Device Number"
                    default 1
                    range 1 10
                    help
                        Maximum number of USB UVC (Video Class) devices that can be 
                        simultaneously connected and managed by the system.

                        This setting determines:
                        - How many USB cameras can be used concurrently
                        - Memory allocation for device management structures
                        - USB host controller resource usage

                        Values:
                        - 1: Single camera operation (default, lowest resource usage)
                        - 2-10: Multi-camera setups (requires more RAM and USB bandwidth)

                        Note: Each additional device increases memory consumption.
                        Ensure adequate USB power supply and bandwidth for multiple cameras.

                config MEDIA_STREAM_USB_UVC_TASK_STACK_SIZE
                    int "USB UVC Task Stack Size"
                    default 4096
                    help
                        Stack size (in bytes) for the USB UVC task that handles camera operations.

                        This task is responsible for:
                        - USB video data processing
                        - Frame buffer management
                        - Camera control command handling

                        Recommended values:
                        - 4096 bytes: Default, suitable for most applications
                        - 6144 bytes: For high-resolution video or complex processing
                        - 8192 bytes: For multiple cameras or intensive operations

                        Increase if you encounter stack overflow errors or use deep call stacks.

                config MEDIA_STREAM_USB_UVC_TASK_PRIORITY
                    int "USB UVC Task Priority"
                    default 10
                    range 2 15
                    help
                        Task priority for the USB UVC task that handles video data processing (higher numbers = higher priority).

                        This controls the scheduling priority of the USB UVC video task relative 
                        to other application tasks. Higher priority ensures more responsive video 
                        processing and smoother frame handling.

                        Priority guidelines:
                        - 10: Default, balanced priority for most video applications
                        - 11-12: Higher priority for low-latency video streaming
                        - 13-15: Maximum priority for real-time video processing
                        - 6-9: Lower priority if video is not time-critical

                        Note: Should typically be lower than USB library task priority (11) to ensure
                        proper USB stack operation. Very high priorities may impact other system tasks.

                config MEDIA_STREAM_USB_UVC_TASK_AFFINITY
                    int "USB UVC Task Affinity"
                    default -1
                    range -1 0 if FREERTOS_UNICORE
                    range -1 1 if !FREERTOS_UNICORE
                    help
                        CPU core affinity for the USB UVC task execution.

                        This determines which CPU core will execute the USB UVC task:
                        - -1: No affinity (FreeRTOS scheduler chooses automatically)
                        - 0: Pin task to CPU core 0 (Protocol core)
                        - 1: Pin task to CPU core 1 (Application core, dual-core only)

                        Recommendations:
                        - Use -1 for automatic load balancing (default)
                        - Use 0 to isolate USB processing from application tasks
                        - Use 1 to keep USB processing with main application

                        Note: Core 1 is only available on dual-core ESP32 variants.

                config MEDIA_STREAM_USB_LIB_TASK_STACK_SIZE
                    int "USB Lib Task Stack Size"
                    default 4096
                    help
                        Stack size (in bytes) for the USB library task that manages USB host operations.

                        This low-level task handles:
                        - USB host controller operations
                        - Device enumeration and management
                        - USB protocol stack processing
                        - Interrupt and event handling

                        Recommended values:
                        - 4096 bytes: Default, suitable for standard USB operations
                        - 6144 bytes: For multiple USB devices or complex configurations
                        - 8192 bytes: For heavy USB traffic or debugging scenarios

                        This is a critical system task - insufficient stack may cause USB failures.

                config MEDIA_STREAM_USB_LIB_TASK_PRIORITY
                    int "USB Lib Task Priority"
                    default 11
                    range 2 15
                    help
                        Task priority for the USB library task (higher numbers = higher priority).

                        This controls the scheduling priority of the USB host library task relative 
                        to other system tasks. Higher priority ensures more responsive USB operations.

                        Priority guidelines:
                        - 11: Default, balanced priority for most applications
                        - 12-13: Higher priority for time-sensitive USB operations
                        - 14-15: Maximum priority for critical real-time USB requirements
                        - 8-10: Lower priority if USB is not performance-critical

                        Note: Should typically be higher than USB UVC task priority (10) to ensure
                        proper USB stack operation. Very high priorities may impact other system tasks.

                config MEDIA_STREAM_USB_LIB_TASK_AFFINITY
                    int "USB Lib Affinity"
                    default -1
                    range -1 0 if FREERTOS_UNICORE
                    range -1 1 if !FREERTOS_UNICORE
                    help
                        CPU core affinity for the USB library task execution.

                        This determines which CPU core will execute the critical USB host library task:
                        - -1: No affinity (FreeRTOS scheduler chooses automatically)
                        - 0: Pin task to CPU core 0 (Protocol core)
                        - 1: Pin task to CPU core 1 (Application core, dual-core only)

                        Recommendations:
                        - Use -1 for automatic load balancing (default)
                        - Use 0 for dedicated USB processing on protocol core
                        - Use 1 if main application runs on core 0

                        Note: USB lib task handles time-critical USB operations, so core affinity
                        can impact performance. Core 1 is only available on dual-core ESP32 variants.

                config MEDIA_STREAM_USB_PERIPHERAL_MAP
                    hex "USB Peripheral Selection Map"
                    default 0x00
                    help
                        Selects which USB peripheral(s) to use on chips with multiple USB controllers.
                        
                        - Set to 0 to use the default peripheral
                        - On High-Speed capable targets, the default is the High-Speed peripheral
                        - On Full-Speed only targets, the default is the Full-Speed peripheral
                        - Example: 0x2 (BIT1) selects USB peripheral 1
                        
                        The mapping of bits to specific peripherals is chip-dependent and defined 
                        in the USB_DWC_LL_GET_HW() macro. This field is only relevant for targets 
                        with multiple USB peripherals.
            endif

            menuconfig MEDIA_STREAM_ENABLE_SPI_CAM_1_SENSOR
                bool "SPI Camera Sensor 1"
                default n
                depends on ESP_VIDEO_ENABLE_THE_SECOND_SPI_VIDEO_DEVICE
                help
                    Serial Peripheral Interface for camera sensors 1.
                    Typically used for lower resolution sensors or special applications.
                    Requires fewer GPIO pins than DVP but has lower bandwidth.
        
            if MEDIA_STREAM_ENABLE_SPI_CAM_1_SENSOR
                config MEDIA_STREAM_SPI_CAM_1_SCCB_I2C_PORT
                    int "SCCB(I2C) Port Number"
                    default 1
                    range 0 2 if IDF_TARGET_ESP32P4
                    range 0 1 if IDF_TARGET_ESP32S3
                    depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                    help
                        I2C port number for camera sensor control communication.

                        SCCB (Serial Camera Control Bus) is an I2C-compatible
                        protocol used for camera sensor configuration.

                config MEDIA_STREAM_SPI_CAM_1_SCCB_I2C_FREQ
                    int "SCCB(I2C) Frequency (100K-400K Hz)"
                    default 100000
                    range 100000 400000
                    help
                        I2C clock frequency for camera sensor communication.

                        Recommended values:
                        - 100000 Hz (100kHz): Standard speed, most compatible
                        - 400000 Hz (400kHz): Fast mode, reduces initialization time

                        Higher frequencies reduce sensor initialization time but may
                        cause issues with some sensors or longer cable connections.

                config MEDIA_STREAM_SPI_CAM_1_SPI_PORT
                    int "SPI Port Number"
                    default 1
                    range 0 2
                    help
                        SPI peripheral number for camera data communication.

                choice MEDIA_STREAM_SPI_CAM_1_XCLK_SOURCE
                    prompt "Select XCLK Source"
                    default MEDIA_STREAM_SPI_CAM_1_XCLK_USE_LEDC
                    help
                        Select the clock source for generating camera sensor XCLK.

                        - LEDC Timer: Uses LED Controller timer for clock generation
                        - ESP Clock Router: Uses dedicated clock routing hardware

                    config MEDIA_STREAM_SPI_CAM_1_XCLK_USE_LEDC
                        bool "LEDC Timer"
                        depends on CAMERA_XCLK_USE_LEDC
                        help
                            Use LED Controller timer to generate camera clock.
                            Provides good accuracy and is available on all ESP32 variants.

                    config MEDIA_STREAM_SPI_CAM_1_XCLK_USE_CLOCK_ROUTER
                        bool "ESP Clock Router"
                        depends on CAMERA_XCLK_USE_ESP_CLOCK_ROUTER
                        help
                            Use dedicated clock routing hardware for camera clock.
                            Provides better performance and lower jitter when available.
                endchoice

                config MEDIA_STREAM_SPI_CAM_1_XCLK_FREQ
                    int "XCLK Frequency (Hz)"
                    default 24000000 if MEDIA_STREAM_SPI_CAM_1_XCLK_USE_CLOCK_ROUTER
                    default 20000000 if MEDIA_STREAM_SPI_CAM_1_XCLK_USE_LEDC
                    help
                        Master clock frequency for SPI camera sensor.

                if MEDIA_STREAM_SPI_CAM_1_XCLK_USE_LEDC
                    config MEDIA_STREAM_SPI_CAM_1_XCLK_TIMER
                        int "XCLK LEDC Timer Number"
                        default 1
                        range 0 3
                        help
                            LEDC timer number for camera clock generation.

                    config MEDIA_STREAM_SPI_CAM_1_XCLK_TIMER_CHANNEL
                        int "XCLK LEDC Timer Channel"
                        default 1
                        range 0 7
                        help
                            LEDC timer channel for camera clock output.
                endif

                if BSP_SELECT_NONE
                    config MEDIA_STREAM_SPI_CAM_1_SCCB_I2C_SCL_PIN
                        int "SCCB(I2C) SCL Pin"
                        default 5 if IDF_TARGET_ESP32P4
                        default 1 if IDF_TARGET_ESP32S3
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                        help
                            GPIO pin for I2C clock signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_1_SCCB_I2C_SDA_PIN
                        int "SCCB(I2C) SDA Pin"
                        default 6 if IDF_TARGET_ESP32P4
                        default 2 if IDF_TARGET_ESP32S3
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                        help
                            GPIO pin for I2C data signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_1_SENSOR_RESET_PIN
                        int "Reset Pin"
                        default -1
                        range -1 54 if IDF_TARGET_ESP32P4
                        range -1 48 if IDF_TARGET_ESP32S3
                        help
                            GPIO pin for camera sensor hardware reset.
                            Set to -1 if not connected or not required.

                    config MEDIA_STREAM_SPI_CAM_1_SENSOR_PWDN_PIN
                        int "Power Down Pin"
                        default -1
                        range -1 54 if IDF_TARGET_ESP32P4
                        range -1 48 if IDF_TARGET_ESP32S3
                        help
                            GPIO pin for camera sensor power-down control.
                            Set to -1 if not connected or not required.

                    config MEDIA_STREAM_SPI_CAM_1_XCLK_PIN
                        int "XCLK Output Pin"
                        default 23 if IDF_TARGET_ESP32P4
                        default 39 if IDF_TARGET_ESP32S3
                        range -1 54 if IDF_TARGET_ESP32P4
                        range -1 48 if IDF_TARGET_ESP32S3
                        help
                            GPIO pin for camera sensor master clock output.
                            Set to -1 if not connected or not required.

                    config MEDIA_STREAM_SPI_CAM_1_CS_PIN
                        int "Chip Select Pin"
                        default 38 if IDF_TARGET_ESP32P4
                        default 42 if IDF_TARGET_ESP32S3
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        help
                            GPIO pin for SPI chip select signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_1_SCLK_PIN
                        int "Clock Pin"
                        default 22 if IDF_TARGET_ESP32P4
                        default 43 if IDF_TARGET_ESP32S3
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        help
                            GPIO pin for SPI clock signal to camera sensor.

                    config MEDIA_STREAM_SPI_CAM_1_DATA0_IO_PIN
                        int "Data0 I/O Pin"
                        default 3 if IDF_TARGET_ESP32P4
                        default 40 if IDF_TARGET_ESP32S3
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        help
                            GPIO pin for SPI data input/output to camera sensor.
                endif
            endif
        endmenu

        menuconfig MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
            bool "Use Pre-initialized SCCB(I2C) Bus for All Camera Sensors And Motors"
            default y if !BSP_SELECT_NONE
            help
                Enable this option to use an I2C bus that has been explicitly
                initialized by your application before camera initialization.
                All camera sensors including the motors use this I2C bus on the
                specified port.

                Benefits:
                - Allows sharing I2C bus with other devices
                - Provides application control over I2C timing
                - Enables custom I2C configuration

                When enabled, you must call i2c_master_bus_init() before
                initializing the camera sensor.

        if MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
            config MEDIA_STREAM_SCCB_I2C_PORT_INIT_BY_APP
                int "SCCB(I2C) Port Number"
                default 0
                range 0 2 if IDF_TARGET_ESP32P4
                range 0 1 if IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32C5
                range 0 0
                help
                    I2C port number for all camera sensors and motors.

            config MEDIA_STREAM_SCCB_I2C_SCL_PIN_INIT_BY_APP
                int "SCCB(I2C) SCL Pin"
                default 8 if IDF_TARGET_ESP32P4
                default 5
                range 0 54 if IDF_TARGET_ESP32P4
                range 0 48 if IDF_TARGET_ESP32S3
                range 0 21 if IDF_TARGET_ESP32C3
                range 0 30 if IDF_TARGET_ESP32C6
                range 0 29 if IDF_TARGET_ESP32C61
                range 0 28 if IDF_TARGET_ESP32C5
                depends on BSP_SELECT_NONE
                help
                    GPIO pin for I2C clock signal to all camera sensors and motors.

            config MEDIA_STREAM_SCCB_I2C_SDA_PIN_INIT_BY_APP
                int "SCCB(I2C) SDA Pin"
                default 7 if IDF_TARGET_ESP32P4
                default 4
                range 0 54 if IDF_TARGET_ESP32P4
                range 0 48 if IDF_TARGET_ESP32S3
                range 0 21 if IDF_TARGET_ESP32C3
                range 0 30 if IDF_TARGET_ESP32C6
                range 0 29 if IDF_TARGET_ESP32C61
                range 0 28 if IDF_TARGET_ESP32C5
                depends on BSP_SELECT_NONE
                help
                    GPIO pin for I2C data signal to all camera sensors and motors.
        endif

        choice MEDIA_STREAM_SELECT_JPEG_ENCODER
            prompt "Select JPEG Encoder Type"
            default MEDIA_STREAM_SELECT_JPEG_HW_DRIVER if IDF_TARGET_ESP32P4
            default MEDIA_STREAM_SELECT_JPEG_ESP_NEW_JPEG if IDF_TARGET_ESP32S3
            help
                Select the JPEG encoder implementation for image compression.

                - Hardware JPEG: Uses dedicated JPEG encoding hardware (faster, lower CPU usage)
                - Software JPEG: Uses CPU-based JPEG encoding (compatible with all targets)

            config MEDIA_STREAM_SELECT_JPEG_HW_DRIVER
                bool "Hardware JPEG Encoder"
                depends on SOC_JPEG_CODEC_SUPPORTED
                help
                    Use dedicated hardware JPEG encoder for image compression.

                    Advantages:
                    - Faster encoding speed
                    - Lower CPU usage
                    - Better power efficiency
                    - Hardware-accelerated compression

                    Available on ESP32-P4 and other chips with JPEG codec support.

            config MEDIA_STREAM_SELECT_JPEG_ESP_NEW_JPEG
                bool "Software JPEG Encoder (esp_new_jpeg)"
                help
                    Use software-based JPEG encoder for image compression.

                    Advantages:
                    - Compatible with all ESP32 variants
                    - No hardware dependencies
                    - Flexible compression parameters

                    Trade-offs:
                    - Higher CPU usage
                    - Slower encoding speed
                    - Higher power consumption
        endchoice
    endmenu

    menu "Video Player (receive path)"
        config MEDIA_STREAM_ENABLE_VIDEO_PLAYER
            bool "Enable inbound H.264 video player (decode + render)"
            # video_render_display backs onto esp_image_effects, which ships
            # only for ESP32-P4. S3 has the esp_h264 SW decoder but no
            # imgfx-accelerated YUV->RGB565 path — until a SW render backend
            # lands, restrict the player to P4 to keep the s3 build clean.
            #
            # The render backend also needs the LVGL display stack
            # (bsp_display_start + lvgl.h), which only the GLIB BSP variants
            # provide — with a NoGLIB BSP the player has nothing to draw on,
            # so it must drop out of the build instead of failing to compile.
            depends on IDF_TARGET_ESP32P4 && BSP_SELECT_GLIB
            default y
            help
                Enable the video player in media_stream so the device can
                decode and render the inbound H.264 video stream from a
                WebRTC peer connection on a connected display.

                On when the target supports the `esp_h264` software decoder
                (ESP32-P4 and ESP32-S3). Set to n to fall back to the no-op
                stub and keep LVGL out of the build. The adapter is only
                activated when the consumer actually wires the
                `media_stream_get_video_player_if()` interface into
                `app_webrtc_config.video_player`.

                PPA-based YUV->RGB565 conversion is used on chips that
                support PPA (CONFIG_SOC_PPA_SUPPORTED), otherwise a CPU
                fallback is used.

        config MEDIA_STREAM_PLAYER_QUEUE_DEPTH
            int "Frame queue depth"
            depends on MEDIA_STREAM_ENABLE_VIDEO_PLAYER
            range 2 64
            default 10
            help
                Number of pending encoded frames the player can queue.
                When full, the player drops newer frames until the next IDR
                to re-sync the decoder.

        config MEDIA_STREAM_PLAYER_TASK_STACK
            int "Decode task stack size (bytes)"
            depends on MEDIA_STREAM_ENABLE_VIDEO_PLAYER
            range 4096 32768
            default 8192
            help
                Stack size for the video player decode task. Allocated in
                SPIRAM via xTaskCreateWithCaps.

        config MEDIA_STREAM_PLAYER_TASK_PRIORITY
            int "Decode task priority"
            depends on MEDIA_STREAM_ENABLE_VIDEO_PLAYER
            range 1 10
            default 4
            help
                Priority of the video player decode task.

        config MEDIA_STREAM_PLAYER_MAX_WIDTH
            int "Max supported video width"
            depends on MEDIA_STREAM_ENABLE_VIDEO_PLAYER
            range 128 1920
            default 320
            help
                Cap on the decoded video width. Used to bound buffer
                allocations.

                The default 320x240 lines up with the P4-EYE LCD
                (240x240) and is the realistic ceiling for sustained
                live playback with the `esp_h264` software decoder +
                CPU YUV->RGB565 convert path. The range is left open
                up to 1920 for boards with larger displays and more
                headroom; bump knowingly.

        config MEDIA_STREAM_PLAYER_MAX_HEIGHT
            int "Max supported video height"
            depends on MEDIA_STREAM_ENABLE_VIDEO_PLAYER
            range 128 1080
            default 240
            help
                Cap on the decoded video height. Used to bound buffer
                allocations. See MAX_WIDTH for default rationale.
    endmenu
endmenu
