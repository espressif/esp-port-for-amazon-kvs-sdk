    menu "Audio Configuration"
        config AUDIO_SAMPLE_RATE
            int "Audio Sample Rate"
            range 8000 48000
            default 48000
            help
                Audio sample rate in Hz.

        config AUDIO_CHANNELS
            int "Number of Audio Channels"
            range 1 2
            default 1
            help
                Number of audio channels (1=mono, 2=stereo).

        config AUDIO_BIT_DEPTH
            int "Audio Bit Depth"
            range 8 32
            default 16
            help
                Audio bit depth in bits.

        config AUDIO_BITRATE
            int "Audio Bitrate"
            range 8000 128000
            default 64000
            help
                Audio bitrate in bits per second.
    endmenu

    menu "Buffer and Tasks Configuration"
        config MEDIA_STREAM_UVC_PASSTHROUGH_H264
            bool "Pass the UVC camera's H.264 through without re-encoding"
            depends on MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR
            default y
            help
                Send the camera's own H.264 straight to WebRTC. Cheapest possible path:
                no ISP, no hardware encoder, and almost no PSRAM traffic.

                The camera then owns bitrate, GOP length and keyframe placement, and the
                host driver has no encoding-unit control to change any of it. On a
                constrained uplink that is usually fatal: a camera that insists on ~3 Mbps
                loses a packet in most frames, the viewer drops them, and a long GOP means
                a complete keyframe may never arrive.

                Leave this off to capture raw and encode locally, which keeps rate control,
                a short GOP and PLI-driven keyframes.

        config MEDIA_STREAM_H264_COMPRESSED_FRAME_MAX_KB
            int "Max compressed H.264/MJPEG frame (KB)"
            default 1024
            help
                Upper bound on one compressed frame, in KB. Every buffer that holds a
                compressed frame is sized from this, on both paths that have one:

                  - the UVC capture buffers, when the camera hands us H.264 or MJPEG.
                    There are three, so capture memory is 3x this.
                  - the hardware encoder's output buffer, when we encode ourselves.

                1 MB carries a 1080p keyframe with room to spare. Raise it if overflow messages
                appear for either of those cases.

        config MEDIA_STREAM_UVC_CAPTURE_WIDTH
            int "UVC capture width"
            depends on MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR
            default 1920
            help
                Width requested from the UVC camera. With passthrough the camera fixes its
                own bitrate, so raising this costs uplink bandwidth without the encoder
                being able to compensate.

        config MEDIA_STREAM_UVC_CAPTURE_HEIGHT
            int "UVC capture height"
            depends on MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR
            default 1080

        config MEDIA_STREAM_UVC_TARGET_FPS
            int "UVC capture frame rate (0 = leave the camera's default)"
            depends on MEDIA_STREAM_ENABLE_USB_UVC_CAM_SENSOR
            default 0
            help
                Frame rate requested from the UVC camera via VIDIOC_S_PARM.

                A UVC camera chooses its own H.264 bitrate and there is no encoding-unit
                control in the host driver to change it, so the frame interval is the only
                way to reduce how much data reaches the uplink. Lower this if the link
                cannot carry the camera's default (frames arrive incomplete and the
                viewer's jitter buffer drops all of them).

                0 leaves the camera at whatever its descriptors default to.

        config VIDEO_ENC_POOL_SLOTS
            int "Encoder output buffers (triple buffering)"
            range 1 8
            default 3
            help
                Number of pre-allocated buffers the encoder rotates its output
                through before handing frames to the sinks.

                This exists to keep the allocator off the camera's critical
                path: without it every frame costs a variable-sized SPIRAM
                alloc, zero and free at the capture rate.

                3 is the useful default. Dispatch is currently synchronous, so
                1 would be correct - but a slot is then reused the moment the
                next frame is encoded, leaving no margin. Three means a
                published frame survives roughly three frame periods, which is
                what an asynchronous dispatcher would need and what absorbs a
                sink that runs long.

                Buffers grow on demand to fit the largest frame seen, so raising
                this costs roughly one keyframe of PSRAM per extra slot.

        config MEDIA_STREAM_CAM_BUFFER_COUNT
            int "Camera capture buffers"
            range 3 8
            default 4
            help
                How many V4L2 capture buffers the camera rotates through.

                This is the pool every raw consumer borrows from. One buffer is
                always being filled by the camera, and each raw sink that takes
                a zero-copy (passthrough) frame holds one for as long as it is
                working on it. MEDIA_STREAM_CAM_BUFFER_RESERVE decides how many
                are held back for the camera; the rest are loanable.

                Each buffer is a full frame in PSRAM, so the cost is real:

                  1280x720 YUV420   1.32 MiB each   4 buffers = 5.27 MiB
                  1920x1080 YUV420  2.97 MiB each   4 buffers = 11.87 MiB

        # Largest reserve that still leaves 2 loanable buffers, which is what the
        # mandatory encoder sink registers for. Without this the pair
        # COUNT=3 / RESERVE=2 passes menuconfig and the encoder sink is then
        # refused at registration, leaving the camera running with nothing
        # encoding it.
        config MEDIA_STREAM_CAM_BUFFER_RESERVE_MAX
            int
            default 1 if MEDIA_STREAM_CAM_BUFFER_COUNT = 3
            default 2 if MEDIA_STREAM_CAM_BUFFER_COUNT = 4
            default 3 if MEDIA_STREAM_CAM_BUFFER_COUNT = 5
            default 4

        config MEDIA_STREAM_CAM_BUFFER_RESERVE
            int "Camera buffers never loaned to sinks"
            range 1 MEDIA_STREAM_CAM_BUFFER_RESERVE_MAX
            default 2
            help
                Buffers held back from the loan budget so the camera always has
                somewhere to write.

                Must be at least 1 (the buffer currently being filled). 2 is the
                useful default: one being filled, one queued behind it, so the
                camera keeps running at full rate while every other buffer is
                out with a sink.

                The upper end is bounded by MEDIA_STREAM_CAM_BUFFER_COUNT: what
                is left over after the reserve has to cover the encoder sink,
                which is always registered and always claims 2 (one queued, one
                being encoded). So a count of 3 forces a reserve of 1, and
                raising the reserve means raising the count with it.

        config VIDEO_SINK_MAX
            int "Maximum number of encoded video sinks"
            range 1 8
            default 4
            help
                How many consumers may register for encoded video frames at
                once. One slot is taken by the built-in "legacy-pull" sink
                that backs video_capture_get_frame().

                Each slot is a small struct, so the cost of raising this is
                negligible - but remember that every enabled sink runs
                sequentially on the encoder task and shares one per-frame time
                budget, so more sinks means less headroom for each.

        config VIDEO_RATE_CTRL_FPS_FLOOR
            int "Rate control: lowest frame rate the ladder may schedule"
            range 1 30
            default 12
            help
                The ladder never asks for fewer frames per second than this, whatever
                the link is doing. Its rungs are clamped up to it, so raising this
                shortens the ladder rather than changing its shape.

                12 is the historical default, measured on a contended 2.4 GHz uplink
                where a single frame took ~70 ms to send: a 15-fps budget (67 ms) stays
                under water and the controller cannot catch up, while 12 fps (~83 ms)
                has the headroom to match those sends.

                Raise it when a consumer has a hard frame-rate requirement and would
                rather lose quality than smoothness - an archive upload that must stay
                at 20 fps, say. The bitrate floor rises with it in effect, since fewer
                bits per frame at more frames is what the encoder is then asked for.

        config VIDEO_RATE_CTRL_MIN_MBPS_PER_PX
            int "Rate control: bitrate floor in milli-bits per pixel per second"
            range 0 2000
            default 280
            help
                Lowest bitrate the ladder may ask for at the current resolution,
                expressed per pixel so it scales: floor = width * height * this / 1000.

                280 puts 720p at 258 kbps and 1080p at 581 kbps, which is where the
                UVC test camera independently clamps and just above the measured bottom
                of usable. Below a floor like this the encoder answers a low target with
                a few KB per key frame - technically a stream, not usefully a picture.

                Raise it for a quality-sensitive deployment (326 gives 300 kbps at
                720p); 0 disables it and leaves only the encoder's own minimum, which
                is resolution-independent and therefore means something very different
                at 320x240 than at 1080p.

        config VIDEO_RATE_CTRL_MAX
            int "Maximum number of video rate controllers"
            range 1 8
            default 4
            help
                How many sinks may run their own congestion-adaptive rate
                controller at once. One per transport that opts in.

                Each controller keeps its own ladder position and congestion
                history; the grabber applies the strict minimum of their targets,
                because a single encoder cannot serve a fast consumer and a slow
                one at the same time.

        config VIDEO_SINK_SLOW_WARN_US
            int "Slow sink warning threshold (us)"
            range 100 100000
            default 5000
            help
                A sink callback taking longer than this is named in a
                rate-limited warning. Sinks run sequentially on the encoder
                task, so a slow one lowers the capture rate for every consumer.

                The budget to compare against is the frame period: 33333 us at
                30 fps, shared between the encoder and all sinks. The 5 ms
                default flags a callback eating ~15% of that, which is well
                before it starts costing frames.

        config VIDEO_RAW_SINK_MAX
            int "Maximum number of raw video sinks"
            range 1 8
            default 5
            help
                How many consumers may register for raw camera frames at once.

                This is a table size, not a budget. The budget is separate: a
                passthrough or converted sink claims queue_depth + 1 camera buffers
                and registration fails once MEDIA_STREAM_CAM_BUFFER_COUNT minus
                MEDIA_STREAM_CAM_BUFFER_RESERVE runs out. Converted sinks are
                charged the same as passthrough ones - they hand the buffers back
                after the conversion rather than after the consumer's work, which
                makes them cheaper in time, not in count. Inline sinks claim
                nothing, so this ceiling is the only one that applies to them.

        config VIDEO_RAW_SINK_SLOW_WARN_US
            int "Slow raw sink warning threshold (us)"
            range 100 1000000
            default 20000
            help
                An inline raw sink holding a frame longer than this is named in
                a rate-limited warning.

                This applies to VIDEO_RAW_MODE_INLINE only, because those run on
                the pump task and delay every other sink.

        config VIDEO_RAW_SINK_BLOCK_TIMEOUT_MS
            int "Default timeout for blocking raw sinks (ms)"
            range 1 5000
            default 100
            help
                How long the pump waits for a VIDEO_RAW_OVERFLOW_BLOCK sink
                before giving up on a frame and counting dropped_timeout.

                Only VIDEO_RAW_OVERFLOW_BLOCK sinks are affected, and each may
                override this in its own config.

        config VIDEO_RAW_SINK_TASK_STACK
            int "Default stack for push-mode raw sink tasks (bytes)"
            range 2048 32768
            default 4096
            help
                Stack for the task the bus runs on behalf of a raw sink that
                supplied an on_frame callback. Allocated from SPIRAM.

                4 KB suits a callback that copies or forwards. Anything running
                a model needs considerably more and should say so in its own
                config, or use the pull API and own its task outright.

        config VIDEO_CAPTURE_PUMP_TASK_STACK
            int "Capture pump task stack (bytes)"
            range 2048 32768
            default 4096
            help
                Stack for the task that dequeues camera frames and publishes
                them to the raw sinks. Allocated from SPIRAM.

                The pump itself needs very little - it dequeues, stamps and
                publishes, and the encoder moved to its own sink task with
                VIDEO_ENCODER_TASK_STACK_SIZE. Raise this only if a sink is
                registered as VIDEO_RAW_MODE_INLINE, which runs on the pump
                and can need whatever it needs.

        config AUDIO_FRAME_QUEUE_SIZE
            int "Audio Frame Queue Size"
            range 1 20
            default 10
            help
                Maximum number of audio frames that can be queued for processing.

        config VIDEO_QUEUE_RECEIVE_WAIT_MS
            int "Camera retry interval (ms)"
            range 10 100
            default 20
            help
                How long the grabber waits before retrying after the camera
                returns no frame.

                Named for the output queue it used to pace. That queue is gone -
                encoded frames go straight to the sinks - so this is now purely
                a camera-starvation backoff. The symbol is kept to avoid
                invalidating existing sdkconfig files.

        config AUDIO_QUEUE_WAIT_MS
            int "Audio Queue Wait Time (ms)"
            range 10 100
            default 20
            help
                Maximum time to wait for audio queue operations.

        config VIDEO_ENCODER_TASK_STACK_SIZE
            int "Video Encoder Task Stack Size (bytes)"
            range 4096 32768
            default 12288 if IDF_TARGET_ESP32S3
            default 8192
            help
                Stack size for the video encoder task.

        config AUDIO_ENCODER_TASK_STACK_SIZE
            int "Audio Encoder Task Stack Size (bytes)"
            range 4096 32768
            default 24576
            help
                Stack size for the audio encoder task.

        config VIDEO_ENCODER_TASK_PRIORITY
            int "Video Encoder Task Priority"
            range 1 10
            default 4
            help
                Priority of the video encoder task (higher number = higher priority).

        config AUDIO_ENCODER_TASK_PRIORITY
            int "Audio Encoder Task Priority"
            range 1 10
            default 4
            help
                Priority of the audio encoder task (higher number = higher priority).
    endmenu

    menu "Video Initialization Configuration"

        menu "Select and Set Camera Sensor Interface"
            menuconfig MEDIA_STREAM_ENABLE_MIPI_CSI_CAM_SENSOR
                bool "MIPI-CSI Camera Sensor"
                default y
                depends on ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE
                help
                    Mobile Industry Processor Interface Camera Serial Interface.
                    High-speed differential serial interface commonly used in
                    mobile devices and professional camera applications.

            if MEDIA_STREAM_ENABLE_MIPI_CSI_CAM_SENSOR
                config MEDIA_STREAM_MIPI_CSI_SCCB_I2C_PORT
                    int "SCCB(I2C) Port Number"
                    default 0
                    range 0 2 if IDF_TARGET_ESP32P4
                    depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                    help
                        I2C port number for camera sensor control communication.

                        SCCB (Serial Camera Control Bus) is an I2C-compatible
                        protocol used for camera sensor configuration.

                config MEDIA_STREAM_MIPI_CSI_SCCB_I2C_FREQ
                    int "SCCB(I2C) Frequency (100K-400K Hz)"
                    default 100000
                    range 100000 400000
                    help
                        I2C clock frequency for camera sensor communication.

                        Recommended values:
                        - 100000 Hz (100kHz): Standard speed, most compatible
                        - 400000 Hz (400kHz): Fast mode, reduces initialization time

                        Higher frequencies reduce sensor initialization time but may
                        cause issues with some sensors or longer cable connections.

                config MEDIA_STREAM_ENABLE_MIPI_CSI_CAM_MOTOR
                    bool "Enable Motor Control"
                    default y
                    depends on ESP_VIDEO_ENABLE_CAMERA_MOTOR_CONTROLLER
                    help
                        Enable Voice Coil Motor (VCM) control for autofocus functionality.

                        This feature is required for camera modules with autofocus
                        capabilities. Disable if using fixed-focus lenses.

                if MEDIA_STREAM_ENABLE_MIPI_CSI_CAM_MOTOR
                    config MEDIA_STREAM_MIPI_CSI_CAM_MOTOR_SCCB_I2C_PORT
                        int "Motor SCCB(I2C) Port Number"
                        default 0
                        range 0 2 if IDF_TARGET_ESP32P4
                        depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                        help
                            I2C port number for autofocus motor control communication.

                            SCCB (Serial Camera Control Bus) is an I2C-compatible
                            protocol used for camera sensor configuration.

                            Can be the same as camera sensor port if sharing the bus.

                    config MEDIA_STREAM_MIPI_CSI_CAM_MOTOR_SCCB_I2C_FREQ
                        int "Motor SCCB(I2C) Frequency (100K-400K Hz)"
                        default 100000
                        range 100000 400000
                        help
                            I2C clock frequency for camera sensor communication.

                            Recommended values:
                            - 100000 Hz (100kHz): Standard speed, most compatible
                            - 400000 Hz (400kHz): Fast mode, reduces initialization time

                            Higher frequencies reduce sensor initialization time but may
                            cause issues with some sensors or longer cable connections.
                endif

                if BSP_SELECT_NONE
                    config MEDIA_STREAM_MIPI_CSI_SCCB_I2C_SCL_PIN
                        int "SCCB(I2C) SCL Pin"
                        default 8
                        range 0 54 if IDF_TARGET_ESP32P4
                        depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                        help
                            GPIO pin for I2C clock signal to camera sensor.

                    config MEDIA_STREAM_MIPI_CSI_SCCB_I2C_SDA_PIN
                        int "SCCB(I2C) SDA Pin"
                        default 7
                        range 0 54 if IDF_TARGET_ESP32P4
                        depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                        help
                            GPIO pin for I2C data signal to camera sensor.

                    config MEDIA_STREAM_MIPI_CSI_CAM_SENSOR_RESET_PIN
                        int "Reset Pin"
                        default -1
                        range -1 54 if IDF_TARGET_ESP32P4
                        help
                            GPIO pin for camera sensor hardware reset.
                            Set to -1 if not connected or not required.

                            Active low signal that resets the camera sensor.

                    config MEDIA_STREAM_MIPI_CSI_CAM_SENSOR_PWDN_PIN
                        int "Power Down Pin"
                        default -1
                        range -1 54 if IDF_TARGET_ESP32P4
                        help
                            GPIO pin for camera sensor power-down control.
                            Set to -1 if not connected or not required.

                            Active high signal that puts the sensor in power-down mode.

                    config MEDIA_STREAM_MIPI_CSI_XCLK_PIN
                        int "XCLK Pin"
                        default -1
                        range -1 54 if IDF_TARGET_ESP32P4
                        help
                            GPIO pin for camera sensor master clock output.
                            Set to -1 if clock is provided by other means.

                            This provides the reference clock signal to the camera sensor.

                    if MEDIA_STREAM_MIPI_CSI_XCLK_PIN >= 0
                        config MEDIA_STREAM_MIPI_CSI_XCLK_FREQ
                            int "XCLK Frequency (Hz)"
                            default 24000000
                            help
                                Master clock frequency for camera sensor.

                                Common values:
                                - 24000000 Hz (24MHz): Standard for most MIPI sensors
                                - 20000000 Hz (20MHz): Alternative for some sensors

                                Check your sensor datasheet for supported frequencies.
                    endif

                    if MEDIA_STREAM_ENABLE_MIPI_CSI_CAM_MOTOR
                        config MEDIA_STREAM_MIPI_CSI_CAM_MOTOR_SCCB_I2C_SCL_PIN
                            int "Motor SCCB(I2C) SCL Pin"
                            default 8
                            range 0 54 if IDF_TARGET_ESP32P4
                            depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                            help
                                GPIO pin for I2C clock signal to autofocus motor.
                                Can share the same pin as camera sensor I2C.

                        config MEDIA_STREAM_MIPI_CSI_CAM_MOTOR_SCCB_I2C_SDA_PIN
                            int "Motor SCCB(I2C) SDA Pin"
                            default 7
                            range 0 54 if IDF_TARGET_ESP32P4
                            depends on !MEDIA_STREAM_SCCB_I2C_INIT_BY_APP
                            help
                                GPIO pin for I2C data signal to autofocus motor.
                                Can share the same pin as camera sensor I2C.

                        config MEDIA_STREAM_MIPI_CSI_CAM_MOTOR_RESET_PIN
                            int "Motor Reset Pin"
                            default -1
                            range -1 54 if IDF_TARGET_ESP32P4
                            help
                                GPIO pin for autofocus motor reset control.
                                Set to -1 if not connected or not required.

                        config MEDIA_STREAM_MIPI_CSI_CAM_MOTOR_PWDN_PIN
                            int "Motor Power Down Pin"
                            default -1
                            range -1 54 if IDF_TARGET_ESP32P4
                            help
                                GPIO pin for autofocus motor power-down control.
                                Set to -1 if not connected or not required.

                        config MEDIA_STREAM_MIPI_CSI_CAM_MOTOR_SIGNAL_PIN
                            int "Motor Signal Pin"
                            default -1
                            range -1 54 if IDF_TARGET_ESP32P4
                            help
                                GPIO pin for autofocus motor control signal.
                                Set to -1 if not connected or motor doesn't require it.
                    endif
                endif

                config MEDIA_STREAM_MIPI_CSI_VIDEO_DEVICE_DONT_INIT_LDO
                    bool "MIPI-CSI Video Device Don't Initialize LDO"
                    default n
                    help
                        If select this option, MIPI-CSI video device will not initialize
                        the LDO and users should initialize the LDO in the application.
            endif

            menuconfig MEDIA_STREAM_ENABLE_DVP_CAM_SENSOR
                bool "DVP Camera Sensor"
                default y if IDF_TARGET_ESP32S3
                default n
                depends on ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE
                help
                    Digital Video Port - parallel interface for camera sensors.
                    Uses multiple GPIO pins for data transmission and control signals.
                    Common in older camera modules and ESP32-CAM boards.

            if MEDIA_STREAM_ENABLE_DVP_CAM_SENSOR
                config MEDIA_STREAM_DVP_SCCB_I2C_PORT
