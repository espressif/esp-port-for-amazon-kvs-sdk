                        help
                            GPIO pin for camera data bit 5.

                    config MEDIA_STREAM_DVP_D6_PIN
                        int "Data6 Pin"
                        default 5 if IDF_TARGET_ESP32P4
                        default 17 if IDF_TARGET_ESP32S3
                        range 0 54 if IDF_TARGET_ESP32P4
                        range 0 48 if IDF_TARGET_ESP32S3
                        help
