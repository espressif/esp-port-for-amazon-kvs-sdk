menu "Media Stream Configuration"
    menu "Video Interface"
        config USE_ESP_VIDEO_IF
            bool "Use ESP Video Interface"
            default y if IDF_TARGET_ESP32P4
            default y if IDF_TARGET_ESP32S3
            help
                Use ESP Video Interface for video capture.

        config ESP_VIDEO_IF_HOR_FLIP
            bool "Horizontal Flip"
            default y
            depends on USE_ESP_VIDEO_IF
            help
                Flip the image horizontally.

        config ESP_VIDEO_IF_VER_FLIP
            bool "Vertical Flip"
            default n
            depends on USE_ESP_VIDEO_IF
            help
                Flip the image vertically.

        config ESP_VIDEO_IF_DQBUF_TIMEOUT_MS
            int "VIDIOC_DQBUF timeout (ms, 0 = wait forever)"
            default 1000
            range 0 60000
            depends on USE_ESP_VIDEO_IF
            help
                How long VIDIOC_DQBUF waits for the driver to hand back a
                captured frame before giving up.

                esp_video defaults this to portMAX_DELAY, and its VFS driver
                implements no select()/poll()/O_NONBLOCK, so a camera that
                stops completing frames wedges the encoder task forever with
                no diagnostic. Bounding it turns that into a NULL return from
                esp_video_if_get_frame(), which callers already handle by
                warning and retrying.

                Keep this comfortably above one frame interval — at 30 fps a
                frame is ~33 ms, so the 1000 ms default only fires when
                capture is genuinely broken. Set 0 to restore the original
                block-forever behaviour.

        config ESP_VIDEO_IF_VERBOSE_DRIVER_LOGS
            bool "Raise esp_video / USB-UVC driver logs to DEBUG"
            default n
            depends on USE_ESP_VIDEO_IF
            help
                Diagnostic aid. Nearly every frame-drop path in esp_video and
                the USB-UVC host stack logs at DEBUG or not at all, so a
                camera that streams zero frames looks identical in the log to
                one that was never started. Enabling this raises the relevant
                tags to DEBUG at esp_video_if_init() time.

                Requires CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y, otherwise the
                DEBUG statements are compiled out and this does nothing.

                Verbose: leave off for normal builds.
    endmenu

